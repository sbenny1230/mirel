{
  "name": "mirel",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "libsodium-wrappers-sumo": "^0.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-libsodium": "^1.7.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:deadcode && npm run test:coverage",
    "lint:deadcode": "knip"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react-native-libsodium$": "<rootDir>/test/sodium-shim.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/testing/"
    ],
    "collectCoverageFrom": [
      "src/lib/{crypto,sync}/**/*.ts",
      "!src/lib/**/{index,types,sqlite-store,supabase-transport}.ts",
      "!src/lib/**/{testing,__tests__}/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 95
      }
    }
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-libsodium"
        ]
      }
    }
  }
}
